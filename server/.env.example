# Copy to .env and fill in. Never commit .env.

# --- Who may use this server ------------------------------------------------
# Authentication is Google Sign-In: the app sends the ID token it already
# holds, and the server verifies the signature, the audience and the address.
#
# The OAuth client ID of the iOS app, from the Google Cloud console
# (APIs & Services -> Credentials -> OAuth client ID -> iOS). No secret is
# involved; iOS clients do not have one. This value must match the one built
# into the app, or every request is refused as "issued for a different app".
MEMORIUM_GOOGLE_CLIENT_ID=

# The allowlist. Comma-separated; case does not matter. Every request must
# carry a verified Google address on this list, so removing someone from it
# revokes them on their next request. An empty list refuses everyone.
MEMORIUM_ALLOWED_EMAILS=you@gmail.com

# Claude Agent SDK authentication (headless).
# Generate with:  claude setup-token
# This token expires and must be refreshed; /health reports when it has.
#
# Unlike the MEMORIUM_* settings below, this one is read by the `claude` CLI
# from the process environment, not from this file. ./run.sh and docker compose
# both load it for you; if you start uvicorn by hand, export it yourself.
# Leave blank if the machine already has an interactive `claude` login.
CLAUDE_CODE_OAUTH_TOKEN=

# Optional overrides
MEMORIUM_CLAUDE_MODEL=claude-haiku-4-5
# Per-task overrides. Blank means "use the model above". Raise one task on its
# own if its output isn't good enough -- e.g. MEMORIUM_ENRICH_MODEL=claude-sonnet-5
MEMORIUM_TRANSLATE_MODEL=
MEMORIUM_ENRICH_MODEL=
MEMORIUM_GRADE_MODEL=
MEMORIUM_MNEMONIC_MODEL=
MEMORIUM_STORY_MODEL=
# Practice phrases. The one worth raising first: a grammatical slip in a
# sentence you are asked to write down is a mistake you then practise.
MEMORIUM_PHRASE_MODEL=
MEMORIUM_ENRICHMENT_WORKERS=2
# Per-call ceiling, seconds. A wedged generation can't hold up the queue.
MEMORIUM_CLAUDE_TIMEOUT_SECONDS=180
MEMORIUM_DATABASE_URL=sqlite:///./data/memorium.db

# Study defaults, seeded into the profile on first run. Changing them later has
# no effect -- edit the profile from the app's Settings screen instead.
MEMORIUM_DEFAULT_SOURCE_LANG=en-US
MEMORIUM_DEFAULT_TARGET_LANG=es-ES
MEMORIUM_DEFAULT_DESIRED_RETENTION=0.90
MEMORIUM_DEFAULT_DAILY_NEW_LIMIT=10
MEMORIUM_DEFAULT_TIMEZONE=Europe/Lisbon
