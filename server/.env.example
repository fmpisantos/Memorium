# Copy to .env and fill in. Never commit .env.

# Shared bearer token the iOS app sends on every request.
# This is the ONLY authentication boundary -- generate a real one:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
MEMORIUM_API_TOKEN=change-me

# Claude Agent SDK authentication (headless).
# Generate with:  claude setup-token
# This token expires and must be refreshed; /health reports when it has.
#
# Unlike the MEMORIUM_* settings below, this one is read by the `claude` CLI
# from the process environment, not from this file. ./run.sh and docker compose
# both load it for you; if you start uvicorn by hand, export it yourself.
# Leave blank if the machine already has an interactive `claude` login.
CLAUDE_CODE_OAUTH_TOKEN=

# Optional overrides
MEMORIUM_CLAUDE_MODEL=claude-opus-5
MEMORIUM_ENRICHMENT_WORKERS=2
# Per-call ceiling, seconds. A wedged generation can't hold up the queue.
MEMORIUM_CLAUDE_TIMEOUT_SECONDS=180
MEMORIUM_DATABASE_URL=sqlite:///./data/memorium.db

# Study defaults, seeded into the profile on first run. Changing them later has
# no effect -- edit the profile from the app's Settings screen instead.
MEMORIUM_DEFAULT_SOURCE_LANG=en-US
MEMORIUM_DEFAULT_TARGET_LANG=es-ES
MEMORIUM_DEFAULT_DESIRED_RETENTION=0.90
MEMORIUM_DEFAULT_DAILY_NEW_LIMIT=10
MEMORIUM_DEFAULT_TIMEZONE=Europe/Lisbon
